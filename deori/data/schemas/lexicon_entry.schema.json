{
  "$defs": {
    "SourceCitation": {
      "additionalProperties": false,
      "description": "Bibliographic or archival source provenance for a linguistic item.",
      "properties": {
        "author": {
          "description": "Author or publishing body",
          "title": "Author",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year of publication",
          "title": "Year"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Title of book, paper, or dataset",
          "title": "Title"
        },
        "page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number or section",
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Web/Archive URL if publicly available",
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "License of source data (e.g. Public Domain, CC BY-SA 4.0)",
          "title": "License"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional citation details",
          "title": "Notes"
        }
      },
      "required": [
        "author"
      ],
      "title": "SourceCitation",
      "type": "object"
    },
    "Variety": {
      "description": "Documented traditional divisions and varieties of Deori.",
      "enum": [
        "dibongiya",
        "tengapaniya",
        "borgonya",
        "patorgonya",
        "historical_brown",
        "community_standard",
        "unspecified"
      ],
      "title": "Variety",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A single lexical entry with strict provenance and dialect tracking.",
  "properties": {
    "id": {
      "description": "Unique entry ID e.g. 'brown_1895_cchu_01'",
      "title": "Id",
      "type": "string"
    },
    "deori": {
      "description": "Primary surface form in citation script",
      "title": "Deori",
      "type": "string"
    },
    "deori_assamese": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Assamese-script spelling (\u09a6\u09c7\u0989\u09f0\u09c0 \u09b2\u09bf\u09aa\u09bf\u09a4)",
      "title": "Deori Assamese"
    },
    "deori_roman": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Roman orthography representation",
      "title": "Deori Roman"
    },
    "ipa": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Phonemic IPA transcription",
      "title": "Ipa"
    },
    "pos": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Part of speech (noun, verb, postposition, etc.)",
      "title": "Pos"
    },
    "gloss_en": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "English definition / gloss",
      "title": "Gloss En"
    },
    "gloss_as": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Assamese definition / gloss",
      "title": "Gloss As"
    },
    "variety": {
      "$ref": "#/$defs/Variety",
      "default": "unspecified",
      "description": "Dialect or regional variety"
    },
    "source": {
      "$ref": "#/$defs/SourceCitation",
      "description": "Bibliographical source with page citation"
    },
    "confidence": {
      "default": 1.0,
      "description": "Attestation confidence (1.0 for verbatim source attestations)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "semantic_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Semantic category (kinship, fauna, agriculture, etc.)",
      "title": "Semantic Field"
    },
    "attested_forms": {
      "description": "Inflected or alternate attested spellings",
      "items": {
        "type": "string"
      },
      "title": "Attested Forms",
      "type": "array"
    },
    "conflicting_entries": {
      "description": "IDs of entries with conflicting lexical or phonological claims",
      "items": {
        "type": "string"
      },
      "title": "Conflicting Entries",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linguistic or historical notes",
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "deori",
    "source"
  ],
  "title": "LexiconEntry",
  "type": "object"
}